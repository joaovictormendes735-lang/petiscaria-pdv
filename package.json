{
  "name": "petiscaria-pdv",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/manage.js migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/manage.js seed",
    "user:create": "node --env-file-if-exists=.env scripts/manage.js user",
    "build": "node scripts/build.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:browser": "node test/browser.js",
    "test:postgres": "node --env-file-if-exists=.env test/postgres.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "esbuild": "^0.27.0",
    "playwright": "^1.56.1"
  }
}
