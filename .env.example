NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:password@localhost:5432/petiscaria
# Produção: URL HTTPS pública exata, sem barra final.
APP_ORIGIN=http://localhost:3000
# require valida certificado TLS; não desative verificação.
DATABASE_SSL=disable
SESSION_HOURS=12
# 1 apenas atrás de UM proxy confiável que sobrescreve X-Forwarded-For.
TRUST_PROXY=0
